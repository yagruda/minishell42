	while(1)
	{
		input = readline("minishell> ");
		if (!input)
		{
			printf("exit\n");
			free(input);
			break;
		}
		if (*input)
		{
			add_history(input);
		}
		if (ft_strcmp(input, "exit") == 0)
		{
			printf("exit\n");
			free(input);
			break;
		}

		if (ft_strcmp(input, "") != 0)
			printf("minishell: %s: command not found\n", input);
		
		free(input);
	}
	